# DSN PostgreSQL — default sudah cocok dengan docker-compose.yml di root repo
DB_DSN=host=localhost user=minishop password=minishop dbname=minishop port=5432 sslmode=disable

# Port HTTP server
PORT=8080

# Origin frontend yang diizinkan CORS (pisahkan dengan koma untuk >1)
ALLOWED_ORIGINS=http://localhost:5173

# Mode gin: kosongkan untuk release, isi "debug" saat development
# GIN_MODE=debug

# DSN PostgreSQL untuk integration test (go test). Tanpa ini test
# di-skip. Env dari shell/CI menang atas nilai di file ini.
TEST_DB_DSN=host=localhost user=minishop password=minishop dbname=minishop port=5432 sslmode=disable
